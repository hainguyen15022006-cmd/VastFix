{
  "name": "vastfix-database-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.11.0 <25" },
  "scripts": {
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:seed": "prisma db seed --config prisma7.config.ts",
    "db:studio": "prisma studio --config prisma7.config.ts",
    "db:verify": "tsx scripts/verify.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "7",
    "@prisma/adapter-pg": "7",
    "dotenv": "^17.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "prisma": "7",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0"
  }
}
