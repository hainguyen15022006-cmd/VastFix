# Development only. Matches database-starter/compose.database.yaml.
DATABASE_URL="postgresql://vastfix_dev:vastfix_dev_only@localhost:5433/vastfix_dev?schema=public"

# Run npm run auth:setup to generate a private secret in .env.
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
# Development Mailpit; does not deliver email to actual USTH mailboxes.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="VastFix Dev <noreply@vastfix.test>"
# Configure SMTP_USER / SMTP_PASSWORD only when using a real mail provider.
VASTFIX_DEMO_AUTH=0

# Bản chạy chung (compose.yaml). Chỉ đổi khi cổng trên máy đã bị dùng.
# VASTFIX_WEB_PORT=3000
# VASTFIX_AI_PORT=8000
# VASTFIX_DB_PORT=5434
# VASTFIX_MAIL_UI_PORT=8025
